# Client ID of your app at https://developer.spotify.com/dashboard
VITE_CLIENT_ID=your_spotify_client_id
# Must match a Redirect URI registered in the dashboard exactly.
# Spotify requires HTTPS, or a loopback IP (127.0.0.1) for local dev — "localhost" is not accepted.
VITE_REDIRECT_URI=https://127.0.0.1:5173/home
# Never put the client secret here: every VITE_* variable ends up in the public JS bundle.
